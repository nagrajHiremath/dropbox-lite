{
  "info": {
    "name": "Dropbox Lite - Metadata Service",
    "description": "Direct-to-service requests for metadata-service (bypasses the API Gateway). Auth is simulated via the X-User-Id header, matching CurrentUserHeaderFilter which normally trusts a header set by the gateway after JWT validation. Run the 'dev' profile DevDataSeeder first (see metadata-service README/notes) to get sample data for the default userId below, then fill in the id-shaped variables from the seeded/created responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082", "type": "string" },
    { "key": "userId", "value": "11111111-1111-1111-1111-111111111111", "type": "string", "description": "Fixed dev-seed test user UUID" },
    { "key": "folderId", "value": "", "type": "string", "description": "e.g. the seeded 'Documents' folder id" },
    { "key": "parentId", "value": "", "type": "string", "description": "Used as a request query param value" },
    { "key": "fileId", "value": "", "type": "string", "description": "e.g. the seeded 'Q3-Report.pdf' file id (has 3 versions)" },
    { "key": "versionId", "value": "", "type": "string" },
    { "key": "shareId", "value": "", "type": "string" },
    { "key": "shareToken", "value": "", "type": "string", "description": "Raw token returned once from Create Share" }
  ],
  "item": [
    {
      "name": "Folders",
      "item": [
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Folder\",\n  \"parentId\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders"]
            }
          }
        },
        {
          "name": "Get Folder by Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders", "{{folderId}}"]
            }
          }
        },
        {
          "name": "List Root Folders",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Omit parentId for root. My Files root view = this + List Files (root)."
          }
        },
        {
          "name": "List Folder Children (by parentId query)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders?parentId={{parentId}}&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders"],
              "query": [
                { "key": "parentId", "value": "{{parentId}}" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Folder Children (by path id)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders/{{folderId}}/children?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders", "{{folderId}}", "children"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Rename or Move Folder",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed Folder\",\n  \"parentId\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders", "{{folderId}}"]
            },
            "description": "Null fields are left unchanged. Set parentId to move the folder."
          }
        },
        {
          "name": "Trash Folder",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders", "{{folderId}}"]
            }
          }
        },
        {
          "name": "Restore Folder",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/folders/{{folderId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "folders", "{{folderId}}", "restore"]
            }
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Get File by Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}"]
            }
          }
        },
        {
          "name": "List Files - My Files (root)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Files - by Folder",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files?folderId={{folderId}}&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files"],
              "query": [
                { "key": "folderId", "value": "{{folderId}}" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Files - Recent",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files?view=recent&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files"],
              "query": [
                { "key": "view", "value": "recent" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Files - Photos (type=image)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files?type=image&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files"],
              "query": [
                { "key": "type", "value": "image" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Files - Videos (type=video)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files?type=video&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files"],
              "query": [
                { "key": "type", "value": "video" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Files - Trash",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files?status=trashed&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files"],
              "query": [
                { "key": "status", "value": "trashed" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Rename File",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed-File.pdf\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}"]
            }
          }
        },
        {
          "name": "Move File",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"folderId\": \"{{folderId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/move",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}", "move"]
            },
            "description": "folderId: null moves the file to root."
          }
        },
        {
          "name": "Trash File",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}"]
            }
          }
        },
        {
          "name": "Restore File",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}", "restore"]
            }
          }
        },
        {
          "name": "Permanently Delete File",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}", "permanent"]
            }
          }
        }
      ]
    },
    {
      "name": "Versions",
      "item": [
        {
          "name": "List Versions",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/versions?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}", "versions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Use the seeded Q3-Report.pdf file id to see 3 versions."
          }
        },
        {
          "name": "Restore Version",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/versions/{{versionId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}", "versions", "{{versionId}}", "restore"]
            },
            "description": "Creates a new current version copying the target version's storage reference."
          }
        }
      ]
    },
    {
      "name": "Sharing",
      "item": [
        {
          "name": "Create Share",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permission\": \"VIEW\",\n  \"expiresAt\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/shares",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}", "shares"]
            },
            "description": "The raw token is only returned in this response - copy it into the shareToken variable to test the public endpoint."
          }
        },
        {
          "name": "List Shares for File",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/files/{{fileId}}/shares",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "files", "{{fileId}}", "shares"]
            }
          }
        },
        {
          "name": "Revoke Share",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shares/{{shareId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shares", "{{shareId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "Get Public Share",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/shares/{{shareToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "shares", "{{shareToken}}"]
            },
            "description": "No auth header - this endpoint is intentionally public. Returns 404 for unknown, revoked, or expired tokens."
          }
        }
      ]
    }
  ]
}
