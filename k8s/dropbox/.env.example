# Copy this file to k8s/dropbox/.env and fill in real values.
# .env is gitignored (see root .gitignore's blanket ".env" rule) - never
# commit real secret values. Consumed by kustomization.yaml's secretGenerator
# to produce the "dropbox-secrets" k8s Secret.

# Shared by the postgres StatefulSet (POSTGRES_PASSWORD) and every Java
# service's DB_PASSWORD - one "dropbox" user owns all three databases
# (account_db, metadata_db, upload_db), matching local dev.
DB_PASSWORD=changeme

# Independent of Lovable's JWT_SECRET - Dropbox's own account-service signs
# tokens, api-gateway validates them, both read this same value.
JWT_SECRET=changeme

# MinIO root credentials for the isolated dropbox-lite MinIO instance.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
