# Copy to .env for local docker-compose use. Do not commit the real .env.

# PostgreSQL (single instance hosting account_db, metadata_db, upload_db)
POSTGRES_USER=dropbox
POSTGRES_PASSWORD=dropbox
POSTGRES_DB=account_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=dropbox-files

# API Gateway CORS - origin(s) the browser-based dropbox-ui SPA is served from.
# Comma-separate multiple origins if needed (e.g. a deployed URL alongside the
# local dev server). No trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173
